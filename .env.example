# API Configuration
EXPO_PUBLIC_RORK_API_BASE_URL=https://mymotivfitx-api.fly.dev

# Sentry Configuration (Optional - for error tracking)
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
# SENTRY_DSN=your-sentry-dsn-here

# Google Maps API Key (for location features)
# Already configured in app.json but can be overridden here if needed
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Rork Private Registry Authentication (for build process)
# RORK_AUTH_TOKEN=your-rork-auth-token
